# ZeroPlay backend configuration
# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=5000

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_backend_only_service_role_key

# Optional fallback key names supported by the app.
# Prefer SUPABASE_SERVICE_ROLE_KEY for backend-only jobs that need elevated writes.
SUPABASE_SECRET_KEY=
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Background team sync
TEAM_SYNC_AUTO_START=false
TEAM_SYNC_INTERVAL_MS=86400000

# Manual admin sync protection. Use a long random value in real environments.
ADMIN_SYNC_TOKEN=replace_with_long_random_admin_token

# Local-only diagnostics. This route is disabled automatically in production.
ENABLE_SUPABASE_DIAGNOSTICS=false
